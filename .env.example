# Solana RPC endpoint (e.g. Helius, Quicknode, Triton, etc.)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE

# Raydium CLMM pool ID to range
POOL_ID=BZtgQEyS6eXUXicYPHecYQ7PybqodXQMvkjUbP4R8mUU

# Token mints (defaults are USDC/USDT)
MINT_A=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
MINT_B=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# Bot loop interval in milliseconds
CHECK_INTERVAL_MS=60000

# ---------------- Wallet mode selection ----------------
# If WALLET_PRIVATE_KEY is set, bot runs in HOT WALLET mode.
# If WALLET_PRIVATE_KEY is empty/unset, bot runs in LEDGER mode.

# HOT WALLET MODE (base58-encoded 64-byte secret key)
# WALLET_PRIVATE_KEY=PasteBase58SecretKeyHere

# LEDGER MODE
# WALLET_ADDRESS is optional but recommended as a safety check.
WALLET_ADDRESS=YourSolanaWalletAddressHere
LEDGER_PATH=44'/501'

# Rebalance residual threshold in USD (default: 1.0)
# Skip the Jupiter rebalance swap when the wallet is within this much of target.
REBALANCE_RESIDUAL_USD=1.0

# Dust threshold in USD (default: 50)
# Min leftover wallet value worth re-depositing; below this the bot stops
# sweeping so it doesn't spend more in swap/top-up fees than the dust is worth.
DUST_THRESHOLD_USD=50

# Percent of the dominant token deposited per round (default: 95).
# The remainder is a slippage cushion vs Raydium error 6021. For a 1-tick
# stable pair (USDC/USDT) price barely moves, so 99 safely deploys more capital.
# Lower it if you see 6021 PriceSlippageCheck errors on a volatile pool.
BASE_DEPOSIT_PCT=99

# Minimum SOL balance in lamports to start a re-range (default: 35000000 = 0.035 SOL)
# Below this the loop skips mutating actions to avoid a half-open position.
MIN_SOL_LAMPORTS=35000000

# Priority fee per compute unit (micro-lamports) applied to every CLMM tx.
# Helps the close->open pipeline land atomically. Set 0 to disable. (default: 50000)
PRIORITY_FEE_MICRO_LAMPORTS=50000

# Compute-unit limit paired with the priority fee (default: 600000)
COMPUTE_UNIT_LIMIT=600000

# Width of the LP position in tick-spacings (default: 3). 1 = single-tick (max APR
# but re-ranges on every crossing and round-trips the WHOLE position through Jupiter
# each time). Wider bands straddle the price, hold both tokens, and so re-range less
# AND swap a smaller fraction per re-range — much less slippage during volatility.
POSITION_WIDTH_SPACINGS=3

# ---------------- Jupiter slippage ----------------
# Tight cap used for normal rebalance swaps (default: 5 bps). A high-price-impact
# route is refused rather than filled, so a $15k stable swap can't eat 0.20%.
JUPITER_SLIPPAGE_BPS=5
# Wider fallback cap, only used if the tight quote cannot route at all (default: 20).
JUPITER_SLIPPAGE_FALLBACK_BPS=20

# ---------------- Re-range cooldown + circuit-breaker (storm protection) ----------------
# After a re-range, refuse to re-range again for this long (ms, default 1200000 = 20 min)
# UNLESS the price has run RERANGE_FAR_TICKS past the band edge (a real move, not a wiggle).
RERANGE_COOLDOWN_MS=1200000
RERANGE_FAR_TICKS=3
# Circuit breaker: if RERANGE_BURST_LIMIT re-ranges happen within RERANGE_BURST_WINDOW_MS,
# stop re-ranging entirely for RERANGE_CIRCUIT_PAUSE_MS (hold the position, no swaps).
RERANGE_BURST_LIMIT=3
RERANGE_BURST_WINDOW_MS=900000
RERANGE_CIRCUIT_PAUSE_MS=3600000

# Disable Raydium token-list preload on startup (recommended in production).
# Set to false only if you need Raydium's token metadata cache.
DISABLE_RAYDIUM_TOKEN_LOAD=true

